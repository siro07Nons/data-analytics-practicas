--4. ¿Cambió la cantidad de unidades vendidas o el importe promedio por transacción?--
SELECT
YEAR(fecha_venta) AS Anio,

SUM(cantidad) AS Unidades_Vendidas,

COUNT(id_venta) AS Cantidad_Transacciones,

SUM(cantidad * precio_unitario) AS Total_Facturado,

SUM(cantidad * precio_unitario) * 1.0
/ NULLIF(COUNT(id_venta), 0) AS Importe_Promedio

FROM ventas

GROUP BY YEAR(fecha_venta)
ORDER BY Anio;

--5. ¿Qué proporción de clientes vuelve a comprar y cómo evoluciona la cantidad de clientes activos?--
WITH Compras_Cliente AS (
SELECT
YEAR(fecha_venta) AS Anio,
id_cliente,
COUNT(id_venta) AS Cantidad_Compras
FROM ventas
GROUP BY
YEAR(fecha_venta),
id_cliente
),

Resumen_Clientes AS (
SELECT
Anio,

COUNT(*) AS Clientes_Activos,

SUM(CASE
WHEN Cantidad_Compras > 1 THEN 1
ELSE 0
END) AS Clientes_Recurrentes

FROM Compras_Cliente
GROUP BY Anio
)

SELECT
Anio,

Clientes_Activos,

Clientes_Recurrentes,

Clientes_Recurrentes * 100.0
/ NULLIF(Clientes_Activos, 0)
AS Porcentaje_Recurrentes,

Clientes_Activos * 100.0
/ NULLIF((SELECT COUNT(*) FROM clientes), 0)
AS Porcentaje_Activos

FROM Resumen_Clientes
ORDER BY Anio;
