-- CONSULTA 1: RESUMEN MENSUAL

SELECT
MONTH(fecha_venta) AS Mes,
SUM(cantidad * precio_unitario) AS Total_Facturado,
COUNT(*) AS Cantidad_Pedidos,
SUM(cantidad * precio_unitario) * 1.0 / COUNT(*) AS Ticket_Promedio
FROM ventas
GROUP BY MONTH(fecha_venta)
ORDER BY Mes;

-- CONSULTA 2: RANKING DE PRODUCTOS

SELECT TOP 5
id_producto,
SUM(cantidad) AS Unidades_Vendidas,
SUM(cantidad * precio_unitario) AS Total_Generado
FROM ventas
GROUP BY id_producto
ORDER BY Total_Generado DESC;

-- CONSULTA 3: CLIENTES RECURRENTES

SELECT
id_cliente,
COUNT(*) AS Cantidad_Pedidos,
SUM(cantidad * precio_unitario) AS Total_Gastado
FROM ventas
GROUP BY id_cliente
HAVING COUNT(*) > 1
ORDER BY Cantidad_Pedidos DESC;

-- CONSULTA 4: COMPARACION DE PRODUCTOS POR ENCIMA O POR DEBAJO DEL PROMEDIO

WITH Facturacion_Producto AS (
SELECT
id_producto,
SUM(cantidad * precio_unitario) AS Total_Facturado
FROM ventas
GROUP BY id_producto
)

SELECT
id_producto,
Total_Facturado,
CASE
WHEN Total_Facturado >
(SELECT AVG(Total_Facturado)
FROM Facturacion_Producto)
THEN 'Por encima'
ELSE 'Por debajo'
END AS Comparacion_Promedio
FROM Facturacion_Producto
ORDER BY Total_Facturado DESC;


