--1. ¿Cómo evolucionaron las ventas mes a mes y que variación presentan frente al periodo anterior?--
SELECT
MONTH(fecha_venta) AS Mes,

SUM(CASE
WHEN YEAR(fecha_venta) = 2023
THEN cantidad * precio_unitario
ELSE 0
END) AS Ventas_2023,

SUM(CASE
WHEN YEAR(fecha_venta) = 2024
THEN cantidad * precio_unitario
ELSE 0
END) AS Ventas_2024,

SUM(CASE
WHEN YEAR(fecha_venta) = 2024
THEN cantidad * precio_unitario
ELSE 0
END)
-
SUM(CASE
WHEN YEAR(fecha_venta) = 2023
THEN cantidad * precio_unitario
ELSE 0
END) AS Diferencia

FROM ventas
GROUP BY MONTH(fecha_venta)
ORDER BY Mes;

--2. ¿Qué territorios aportan más ventas y cuales muestran las mayores caídas o mejoras?--
SELECT
c.ciudad AS Territorio,

SUM(CASE
WHEN YEAR(v.fecha_venta) = 2023
THEN v.cantidad * v.precio_unitario
ELSE 0
END) AS Ventas_2023,

SUM(CASE
WHEN YEAR(v.fecha_venta) = 2024
THEN v.cantidad * v.precio_unitario
ELSE 0
END) AS Ventas_2024,

SUM(CASE
WHEN YEAR(v.fecha_venta) = 2024
THEN v.cantidad * v.precio_unitario
ELSE 0
END)
-
SUM(CASE
WHEN YEAR(v.fecha_venta) = 2023
THEN v.cantidad * v.precio_unitario
ELSE 0
END) AS Diferencia

FROM ventas v
INNER JOIN clientes c
ON v.id_cliente = c.id_cliente

GROUP BY c.ciudad
ORDER BY Diferencia DESC;

